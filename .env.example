# Скопируй в .env и впиши значения. .env в git не попадает.

# --- обязательные ---
# токен от @BotFather
BOT_TOKEN=
# твой telegram_user_id (@userinfobot); всех остальных бот игнорирует
OWNER_ID=585800070
SUPABASE_URL=https://fjkjqkqzkjjuusonbyep.supabase.co
# Supabase → проект bot-archive → Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio, с привязанной оплатой
GEMINI_API_KEY=

# --- необязательные (есть значения по умолчанию) ---
# id канала-архива; пусто = бот запомнит канал сам, когда его сделают там админом
ARCHIVE_CHANNEL_ID=
GEMINI_MODEL=gemini-flash-latest
# запасные модели через запятую — если основная отвечает 503/404
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
# сколько записей обрабатывать одновременно
WORKER_CONCURRENCY=2
# порог для «≈ похоже на: …» (0–1, выше = строже)
SIMILAR_THRESHOLD=0.9
# папка для временных скачиваний (чистится после каждой записи)
TMP_DIR=/tmp/bot-archive
# адрес Mini App «Архив» (кнопка «Меню»); пусто = кнопки нет
MINIAPP_URL=https://bot-archive-miniapp.vercel.app

# --- большие файлы: локальный telegram-bot-api (файлы до 2 ГБ вместо 20 МБ) ---
# my.telegram.org → API development tools → App api_id / App api_hash.
# Оба заполнены → scripts/start-mac.sh сам запускает сервер (собрать один раз: bash scripts/build-bot-api.sh).
# Пусто → облачный Bot API, лимит 20 МБ. BOT_API_URL / BOT_API_DIR вписывать не нужно — их задаёт скрипт.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# копии полученных файлов на Маке удаляются через столько дней (оригиналы остаются в канале-архиве)
BOT_API_KEEP_DAYS=3
